OPENAI_API_KEY=
# OPENAI_BASE_URL=https://university.example/v1
EXTRACTOR_MODEL=gpt-5-mini
REFINER_MODEL=gpt-5.6-luna
WRITER_MODEL=gpt-5.4-nano
REVIEWER_MODEL=gpt-6-luna
MAX_REVISIONS=3
EXTRACTION_CHUNK_SIZE=12000
EXTRACTION_OVERLAP_LINES=2
EXTRACTION_ATTEMPTS=3
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2
# auto tries json_schema, then json_object, then prompted JSON on explicit rejection
OPENAI_OUTPUT_MODE=auto
OPENAI_MAX_OUTPUT_TOKENS=8000
# Older endpoints may require max_tokens instead
OPENAI_OUTPUT_TOKEN_PARAMETER=max_completion_tokens
